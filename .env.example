# ==========================================
# SentinelCare AI - Environment Configuration
# ==========================================

# Google Gemini API Key (Multimodal Vision OCR & Clinical Drug Interaction Auditing)
# If omitted, SentinelCare AI automatically uses its built-in clinical intelligence fallback engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key (Optional: for production live SMTP/HTTP email dispatch)
# If omitted, SentinelCare AI simulates delivery and renders complete interactive HTML receipts.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=alerts@sentinelcare.ai
